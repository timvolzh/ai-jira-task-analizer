# Jira
JIRA_URL=https://jira.example.local
JIRA_USER=your-user
JIRA_TOKEN=your-token-or-password
JQL=project = DEMO ORDER BY created DESC
LIMIT=50
FIELDS=summary,description
INCLUDE_COMMENTS=false

# MLServer
MLSERVER_URL=http://mlserver.example.local
MODEL_NAME=your-model
REQUEST_TIMEOUT=30

# Prompt and RAG
SYSTEM_PROMPT_PATH=system_prompt.txt
RAG_PATH=rag.txt
RAG_MAX_CHARS=2000
MAX_PROMPT_CHARS=6000

# Output and logging
OUTPUT_DIR=output
LOG_LEVEL=INFO
